	(text "0.4v max as power good low level\nWhen output voltage is > 0.92xVout \nthen PG is high impedance \nmeaning pull up makes it high\nSo when vout is 1.8 then pg is pulled up \nand 3.3vd is enabled."
		(exclude_from_sim no)
		(at 182.88 111.252 0)
		(effects
			(font
				(size 1 1)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a5135677-5240-4c86-ad67-f960a7b5d74e")
	)
	(text "PG output is open drain\npull up is needed"
		(exclude_from_sim no)
		(at 226.06 118.618 0)
		(effects
			(font
				(size 1 1)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "c764c02d-9ac6-4249-847d-b723298a1cb5")
	)
	(text "In the Artix-7 data sheet it states that the recommended \npower-on sequence is VCCINT, VCCBRAM, VCCAUX, and VCCO.\n1v0 first 1v8 then 3v3 is the sequence so use power good"
		(exclude_from_sim no)
		(at 113.03 32.004 0)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.3048)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "d444e76c-c657-4f73-864e-185228335432")
	)
	(text "2A buck converter"
