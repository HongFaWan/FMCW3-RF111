(version 1)
(rule "manufacturer track width"
 (constraint track_width (min 0.1016mm)))
(rule "manufacturer copper spacing"
 (constraint clearance (min 0.1016mm)))
(rule "manufacturer drilled hole"
 (constraint hole_size (min 0.2mm)))

(rule "L3 VCC2 track to copper pour"
 (layer "In2.Cu")
 (constraint clearance (min 0.180mm))
 (condition "A.Type == 'Track' && A.NetName == 'Net-(U14-VCC2)' && B.Type == 'Zone'"))
